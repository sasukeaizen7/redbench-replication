				let
				    Source = Csv.Document(File.Contents(DataFolder & "clusters.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"cluster", type text}, {"variant", type text}, {"highlight", type text}, {"queries", Int64.Type}, {"selects", Int64.Type}, {"qrr_dml", type number}, {"qrr", type number}, {"srr_dml", type number}, {"srr", type number}, {"qrr_dml_first1k", type number}}, "en-US")
