	partition repetition = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "repetition.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"series", type text}, {"series_order", Int64.Type}, {"metric", type text}, {"metric_order", Int64.Type}, {"source", type text}, {"value", type number}, {"source_order", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

