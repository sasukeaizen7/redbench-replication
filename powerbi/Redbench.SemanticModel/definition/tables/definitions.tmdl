	partition definitions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "definitions.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Headers, {{"series", type text}, {"definition", type text}, {"definition_order", Int64.Type}, {"metric", type text}, {"metric_order", Int64.Type}, {"value", type number}}, "en-US")
				in
