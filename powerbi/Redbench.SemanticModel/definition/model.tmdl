model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "claims", "repetition", "definitions", "query_mix", "skew", "strings", "clusters"]

annotation PBI_ProTooling = ["DevMode"]

ref table claims
ref table repetition
ref table definitions
ref table query_mix
ref table skew
ref table strings
ref table clusters

